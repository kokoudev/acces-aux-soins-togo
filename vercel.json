{
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "500mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/_dash-component-suites/plotly/package_data/plotly(\\.v[^/]*)?\\.min\\.js",
      "status": 308,
      "headers": {
        "Location": "https://cdn.plot.ly/plotly-4.1.1.min.js"
      }
    },
    {
      "src": "/(.*)",
      "dest": "index.py"
    }
  ]
}
